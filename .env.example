# Postgres (Railway: use DATABASE_PUBLIC_URL locally, DATABASE_URL reference var in the service)
DATABASE_URL=postgresql://user:pass@host:port/railway
# Any long random string
SESSION_SECRET=
DEEPSEEK_API_KEY=
