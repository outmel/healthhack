# Postgres (Railway: use DATABASE_PUBLIC_URL locally, DATABASE_URL reference var in the service)
DATABASE_URL=postgresql://user:pass@host:port/railway
# Any long random string
SESSION_SECRET=
DEEPSEEK_API_KEY=
# Optional override (defaults to deepseek-flash)
# DEEPSEEK_MODEL=
# Optional; demo password for all three seeded users (default teman2026)
# DEMO_PASSWORD=
# n8n analysis workflow (n8n/teman-analysis-workflow.json)
# On Railway: http://${{n8n.RAILWAY_PRIVATE_DOMAIN}}:5678/webhook/teman-analyse
N8N_WEBHOOK_URL=
# Same value as the "Teman webhook secret" Header Auth credential in n8n (header name x-teman-secret)
N8N_WEBHOOK_SECRET=
